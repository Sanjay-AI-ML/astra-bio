{
  "name": "ASTRA-BIO Python 3.12",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:3-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "astra_bio/api.py",
        "frontend/src/main.jsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "features": {"ghcr.io/devcontainers/features/node:1": {"version": "24"}},
  "updateContentCommand": "python -m pip install uv && uv sync --locked --python 3.12 && npm ci --prefix frontend && npm run build --prefix frontend",
  "postAttachCommand": {
    "server": "uv run python -m astra_bio.telemetry && uv run uvicorn astra_bio.api:app --host 0.0.0.0 --port 8501"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
